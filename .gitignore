# ============================================================
# 1) 秘钥与隐私信息 —— 绝不入库（重要）
# ============================================================
.env
.env.*
*.env
!.env.example
secrets/
*.pem
*.key
*.p12
*_rsa
credentials*.json
*service-account*.json
.mcp.json
mcp.json

# ============================================================
# 2) 开发软件配置目录 —— 本地 IDE / Agent 配置不上传
# ============================================================
.claude/
.zcode/
.cursor/
.vscode/
.idea/
.windsurf/
.qoder/
.trae/
.augment/
.agents/
.codex/
continue/
.devcontainer/

# Agent 本地指令文件（含个人工作流偏好，防泄漏）
AGENTS.md
CLAUDE.md
GEMINI.md

# ============================================================
# 3) 内部文档与开发状态 —— 不纳入版本控制，防内部信息外泄
#    （注意：docs/ 是 skill 功能文档，随包发布，勿加入此处）
# ============================================================
dev/
internal/
notes/
devlog/
docs-private/
.obsidian/
DEVLOG*.md
NOTES.md
TODO.md
*-private.md
*.draft.md
*.local.md

# ============================================================
# 4) 运行产物与缓存
# ============================================================
# 仅忽略仓库根的 dist/（工具默认输出目录）；
# examples/ 下的 dist 是示例产物，正常入库
/dist/
build/
out/
*.log
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
node_modules/

# ============================================================
# 5) 系统杂项
# ============================================================
.DS_Store
Thumbs.db
desktop.ini
*.swp
